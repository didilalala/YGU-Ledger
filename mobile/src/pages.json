		"backgroundColor": "#ffffff",
		"borderStyle": "black",
		"list": [
			{ "pagePath": "pages/dashboard/index", "text": "首页" },
			{ "pagePath": "pages/reports/index", "text": "统计" },
			{ "pagePath": "pages/ai/chat", "text": "AI助手" },
