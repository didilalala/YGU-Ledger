# 复制为 .env 后修改。docker compose 和 Django 都读取这个文件。

# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 通过 nginx 用域名访问时填写，如 https://ledger.example.com
CSRF_TRUSTED_ORIGINS=http://localhost
GUNICORN_WORKERS=2

# ---------- MySQL ----------
MYSQL_DATABASE=litenote
MYSQL_USER=litenote
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# 容器内连接地址（host 为 compose 中的服务名 db）
DATABASE_URL=mysql://litenote:change-me@db:3306/litenote

# ---------- 安全 ----------
# 加密 AI API Key 的密钥，生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ---------- 语音识别（兼容 OpenAI 协议，可选）----------
ASR_API_URL=
ASR_API_KEY=
ASR_MODEL=qwen3-asr-flash
